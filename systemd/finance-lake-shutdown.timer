# Mac Miniホスト（Ubuntu 24.04 LTS）に配置するsystemdタイマーユニットの例。
# /etc/systemd/system/finance-lake-shutdown.timer にコピーする
# （finance-lake-shutdown.serviceと対で使う）。
#
# 04:02:00 JSTは、edinet-dl.timer（04:01:30 JST）・jpx-daily-pdf-dl.timer（04:01:00 JST）
# のいずれよりも後の時刻。両タイマーが確実に発火し終えた後でなければ、まだ実行中でない
# サービスを「待つ必要なし」と誤判定してしまうため。今後サービスのタイマーを追加する
# 場合は、この時刻がそれらより後になっているか確認すること。
#
# マシンのシステムタイムゾーンはUTC（Etc/UTC）だが、Tapoの電源投入時刻はJSTで管理して
# いるため、OnCalendarにも明示的にAsia/Tokyoを指定する。

[Unit]
Description=Run finance-lake-shutdown after daily fetch jobs

[Timer]
OnCalendar=*-*-* 04:02:00 Asia/Tokyo
Persistent=true

[Install]
WantedBy=timers.target
