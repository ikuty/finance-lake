EDINET_API_KEY=your-edinet-api-key-here
DB_PATH=/data/edinet_index.db
DATA_DIR=/data/raw
LOG_PATH=/data/logs/edinet-dl.log
REQUEST_DELAY=1.2
DAYS_WINDOW=3
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# バックフィル進捗レポートのS3アップロード（任意、未設定ならアップロード自体を
# スキップする）。AWS_ACCESS_KEY_ID・AWS_SECRET_ACCESS_KEY・AWS_DEFAULT_REGIONは
# boto3が自動で読む標準の環境変数名。jpx-daily-pdf-dlと同じバケットを使う
# （キーで名前空間を分けている）。
S3_BUCKET_NAME=ikuty-finance
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=ap-northeast-1
