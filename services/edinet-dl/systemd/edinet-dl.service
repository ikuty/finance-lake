# Mac Miniホスト（Ubuntu 24.04 LTS）に配置するsystemdサービスユニットの例。
# /etc/systemd/system/edinet-dl.service にコピーし、自分の環境の実際のユーザー名・パスに
# 合わせて書き換えること。
#
# マシンのシャットダウンはこのunitでは行わない。共有unit（リポジトリ直下の
# systemd/finance-lake-shutdown.service）が、全サービス共通で一手に引き受ける
# （2026-09-06決定。以前はこのunitの2行目でshutdownを呼んでいたが、他サービスの
# 実行時間次第ではそれより前にshutdownが走ってしまう非対称な設計だったため分離した）。
#
# --csv --pdf: 当面はCSV・PDFのみ取得し、XBRLは対象外とする（2026-08-28決定）。
# ファンダメンタル分析の核心（財務諸表の数値項目）はCSVでカバーでき、XBRLでしか
# 得られない補足情報（セグメント内訳・大株主・役員一覧等）が必要になった段階で
# --xbrl を追加する。詳細はdocs/file_download_design.md参照。
#
# 有効化・起動確認:
#   sudo systemctl daemon-reload
#   sudo systemctl enable edinet-dl.timer
#   sudo systemctl start edinet-dl.timer
#   systemctl list-timers edinet-dl.timer
#   journalctl -u edinet-dl.service

[Unit]
Description=EDINET daily document fetch
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/docker run --rm --env-file /home/<user>/finance-lake/services/edinet-dl/.env -v /home/<user>/finance-lake/data/edinet-dl:/data edinet-dl:latest --csv --pdf
