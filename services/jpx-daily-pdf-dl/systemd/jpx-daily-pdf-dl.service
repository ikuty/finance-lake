# Mac Miniホスト（Ubuntu 24.04 LTS）に配置するsystemdサービスユニットの例。
# /etc/systemd/system/jpx-daily-pdf-dl.service にコピーし、自分の環境の実際の
# ユーザー名・パスに合わせて書き換えること。
#
# このunitはシャットダウンのExecStartを持たない。マシンのシャットダウンは共有unit
# （リポジトリ直下のsystemd/finance-lake-shutdown.service）が全サービス共通で
# 一手に引き受ける（2026-09-06決定）。finance-lake-shutdown.serviceは
# `After=edinet-dl.service jpx-daily-pdf-dl.service`により、本サービスが実行中
# であればシャットダウンの開始を自動的に待つため、実行時間が多少延びても安全。
#
# 有効化・起動確認:
#   sudo systemctl daemon-reload
#   sudo systemctl enable jpx-daily-pdf-dl.timer
#   sudo systemctl start jpx-daily-pdf-dl.timer
#   systemctl list-timers jpx-daily-pdf-dl.timer
#   journalctl -u jpx-daily-pdf-dl.service

[Unit]
Description=JPX daily stock quotation fetch
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/docker run --rm --env-file /home/<user>/finance-lake/services/jpx-daily-pdf-dl/.env -v /home/<user>/finance-lake/data/jpx-daily-pdf-dl:/data jpx-daily-pdf-dl:latest
